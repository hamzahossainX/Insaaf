# Local PostgreSQL (matches ../docker-compose.yml)
DATABASE_URL="postgresql://insaaf:insaaf@localhost:5432/insaaf_erp?schema=public&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://insaaf:insaaf@localhost:5432/insaaf_erp?schema=public"

# For Neon, use its pooled URL as DATABASE_URL and direct URL as DIRECT_URL.
# Start with connection_limit=5&pool_timeout=20 on the pooled URL, then tune
# against your Neon/Vercel plan and observed concurrent traffic.
# Never commit real database credentials.

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="12h"
PORT=4000
FRONTEND_URL="http://localhost:5173"
