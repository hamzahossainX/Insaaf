# ──────────────────────────────────────────────────────────────────────────────
# Neon PostgreSQL (https://neon.tech)
# ──────────────────────────────────────────────────────────────────────────────

# DATABASE_URL  → Neon *pooler* endpoint (used at runtime by the app + Vercel serverless)
# Append &pgbouncer=true so Prisma knows it is talking to PgBouncer.
DATABASE_URL="postgresql://neondb_owner:<password>@ep-dry-mud-au19saps-pooler.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=1"

# DIRECT_URL → Neon *direct* (non-pooled) endpoint — used ONLY by `prisma migrate`
# Get this from your Neon console: Connection string → "Pooling" toggle OFF
DIRECT_URL="postgresql://neondb_owner:<password>@ep-dry-mud-au19saps.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ──────────────────────────────────────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="12h"

# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
PORT=4000

# ──────────────────────────────────────────────────────────────────────────────
# CORS — set to your Vercel frontend URL in production, e.g.:
#   FRONTEND_URL="https://insaaf-erp.vercel.app"
# ──────────────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
